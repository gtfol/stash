# stash works with none of these: links are kept in the browser, and sign-in and sync stay off.
# Sync (Google sign-in) needs all of them. Copy to .env.local for local development; never commit
# real values. In Vercel, set them under Settings → Environment Variables.

# The stash Supabase project's transaction pooler connection string (Connect → Transaction
# pooler, port 6543), with the database password filled in.
DATABASE_URL=
# Supabase's root certificate, from Database → Settings → SSL Configuration, as PEM text
# (real line breaks or \n escapes). Remote connections always verify TLS.
DATABASE_SSL_CA=
# A unique random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This deployment's address, such as https://stash.gtfol.dev (http://localhost:3000 locally).
BETTER_AUTH_URL=http://localhost:3000
# A Google OAuth "Web application" client with redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
